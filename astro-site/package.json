{
  "name": "yanghua-astro-site",
  "type": "module",
  "version": "0.1.0",
  "description": "A minimal, fast, and fully customisable small-business website template built with Astro 5, Tailwind v4, and Playwright.",
  "author": "",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-theme",
    "astro5",
    "tailwind",
    "tailwindcss",
    "small-business",
    "starter",
    "template",
    "view-transitions",
    "playwright"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.6.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "astro preview",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "astro check",
    "validate": "pnpm run check && pnpm run build && pnpm run test:articles && pnpm run test",
    "test:articles": "node --test tests/articles-core.test.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:perf": "playwright test tests/performance.spec.ts",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.2",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/vercel": "8",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.18.2",
    "astro-robots-txt": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.22.0",
    "nodemailer": "^6.10.1",
    "react": "^18",
    "react-dom": "^18",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.58.2",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "vite": "6.3.6"
    }
  }
}