# ============================================
# Yanghua Cable B2B Website - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================

# ===== Public / Client-Side (prefixed with PUBLIC_) =====
# Controls environment mode: "production" | "preview" | "development"
# - production: enables index/follow, shows tracking scripts
# - non-production: disables indexing, noindex nofollow
PUBLIC_SITE_ENV=production

# Google Tag Manager container ID (format: GTM-XXXXXXX)
# Takes priority over GA4 if both are set
PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX)
# Only used if GTM is not configured
PUBLIC_GA4_ID=

# ===== Legacy Compatibility (Next.js migration) =====
# These are fallback values during the Next.js → Astro migration
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ===== Email Provider =====
# When RESEND_API_KEY is set, Resend is used for both inquiry and subscription mail.
# The sender domain must be verified in Resend.
RESEND_API_KEY=
# Optional: add subscribers to a Resend Audience as well as sending an internal notice.
RESEND_AUDIENCE_ID=

# ===== SMTP Fallback / Local Testing =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ===== Email Sending =====
# Sender information for outbound emails
EMAIL_FROM=noreply@yhflexiblebusbar.com
EMAIL_FROM_NAME=Yanghua Cable

# Recipient addresses for form submissions
CONTACT_EMAIL=info@yhflexiblebusbar.com
INQUIRY_EMAIL=sales@yhflexiblebusbar.com
SUBSCRIPTION_EMAIL=sales@yhflexiblebusbar.com

# ===== Security =====
# CSRF token signing secret - MUST be at least 32 characters in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# ===== Email Service Tuning =====
# Number of retry attempts for failed email sends
EMAIL_RETRY_ATTEMPTS=3
# Delay in milliseconds between retries (multiplied by attempt number)
EMAIL_RETRY_DELAY_MS=1000
# IndexNow notifications (the key file is deployed from public/)
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=https://www.yhflexiblebusbar.com/664b51f681d527165b2b9ddfa0baa0d3941c8392135481d74ac3d0278eda514d.txt
# Optional comma/newline-separated absolute URLs; omitted uses the core trilingual URL set.
INDEXNOW_URLS=
