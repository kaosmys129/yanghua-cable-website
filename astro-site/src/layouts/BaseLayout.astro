---
/**
 * Base layout — wraps every page.
 *
 * Astro 6 features used:
 *  • <ClientRouter /> — client-side navigation with CSS transition animations
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { brand } from '../config/brand';
import type { Locale } from '../lib/yanghua/loaders';
import type { NormalizedSiteSettings } from '../lib/yanghua/site-settings';
import { loadAndNormalizeSiteSettings } from '../lib/yanghua/site-settings';
import { generateFullOrganizationSchema } from '../lib/schema-utils';
import { buildHreflangAlternates } from '../lib/yanghua/hreflang';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  image?: string;
  schema?: Record<string, unknown>;
  /**
   * Locales that actually have this page. For CMS-driven content (articles)
   * the page computes this from real data so we never emit a 404 alternate.
   * When omitted, structural locale exceptions are applied (see hreflang.ts).
   */
  availableLocales?: Locale[];
  /**
   * 可选：由页面层注入站点设置，以避免 layout 内部读取文件。
   * 若不传，则 layout 会自行从旧站 `content/settings/site.json` 读取并归一化。
   */
  site?: NormalizedSiteSettings;
}

function detectLocaleFromPathname(pathname: string): Locale {
  if (pathname.startsWith('/es')) return 'es';
  if (pathname.startsWith('/pt')) return 'pt';
  return 'en';
}

const locale = (Astro.props.locale ?? detectLocaleFromPathname(Astro.url.pathname)) as Locale;
const site = Astro.props.site ?? (await loadAndNormalizeSiteSettings(locale));

const {
  title = site.seo.defaultTitle || brand.name,
  description = site.seo.defaultDescription || brand.description,
  image = site.seo.defaultOgImage || '/og-image.png',
  schema,
} = Astro.props;

const resolvedSchema = schema ?? generateFullOrganizationSchema(String(Astro.site ?? brand.url));

const pageTitle = title === site.brand.name ? title : `${title} — ${site.brand.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? brand.url);

const hreflangAlternates = buildHreflangAlternates(
  Astro.url.pathname,
  String(Astro.site ?? brand.url),
  Astro.props.availableLocales
);

const siteEnv = String(
  import.meta.env.PUBLIC_SITE_ENV ||
    process.env.PUBLIC_SITE_ENV ||
    process.env.VERCEL_ENV ||
    (import.meta.env.DEV ? 'development' : 'production')
).toLowerCase();
const isIndexableEnvironment = siteEnv === 'production';
const robotsContent = isIndexableEnvironment ? 'index, follow' : 'noindex, nofollow';

const gtmId = String(
  import.meta.env.PUBLIC_GTM_ID ||
    process.env.PUBLIC_GTM_ID ||
    import.meta.env.NEXT_PUBLIC_GTM_ID ||
    process.env.NEXT_PUBLIC_GTM_ID ||
    ''
).trim();
const ga4Id = String(
  import.meta.env.PUBLIC_GA4_ID ||
    process.env.PUBLIC_GA4_ID ||
    import.meta.env.NEXT_PUBLIC_GA_MEASUREMENT_ID ||
    process.env.NEXT_PUBLIC_GA_MEASUREMENT_ID ||
    ''
).trim();
const hasGtm = /^GTM-[A-Z0-9]+$/i.test(gtmId);
const hasGa4 = !hasGtm && /^G-[A-Z0-9]+$/i.test(ga4Id);
const trackingConfig = {
  gtmId: hasGtm ? gtmId : '',
  ga4Id: hasGa4 ? ga4Id : '',
  siteEnv,
  language: locale,
};
---

<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />
    {hreflangAlternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <meta name="robots" content={robotsContent} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {hasGtm && (
      <script
        is:inline
        set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`}
      />
    )}

    {hasGa4 && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());`}
        />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={image} />
    <meta property="og:locale"      content={locale} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Fonts: use a plain stylesheet to avoid Astro's build-time font HTTP server in restricted environments. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Oswald:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data (auto-generated Organization schema when no page-level schema provided) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(resolvedSchema)} />

    <!--
      设计 token 单源覆盖：
      theme.css 负责注册 token 名（Tailwind v4 @theme），这里以 brand.ts 的值在运行时覆盖，
      避免每次换品牌都要手动同步 theme.css 里的 hex。
    -->
    <style is:inline>
      :root {
        color-scheme: light only;
        --color-primary: {brand.colors.primary};
        --color-primary-light: {brand.colors.primaryLight};
        --color-primary-fg: {brand.colors.primaryFg};
        --color-accent: {brand.colors.accent};
        --color-accent-fg: {brand.colors.accentFg};
        --color-background: {brand.colors.background};
        --color-surface: {brand.colors.surface};
        --color-border: {brand.colors.border};
        --color-text: {brand.colors.text};
        --color-text-muted: {brand.colors.textMuted};
        --color-dark: {brand.colors.dark};
        --color-dark-surface: {brand.colors.darkSurface};
        --radius-sm: {brand.radius.sm};
        --radius-md: {brand.radius.md};
        --radius-lg: {brand.radius.lg};
        --radius-full: {brand.radius.full};
      }
    </style>

    <slot name="head" />
    <script is:inline set:html={`window.__YANGHUA_TRACKING__=${JSON.stringify(trackingConfig)};`} />
    <script is:inline>
      (() => {
        const config = window.__YANGHUA_TRACKING__ || {};
        window.dataLayer = window.dataLayer || [];

        const enrich = (params = {}) => ({
          page_location: window.location.href,
          page_path: window.location.pathname,
          page_title: document.title,
          language: document.documentElement.lang || config.language || '',
          site_env: config.siteEnv || '',
          ...params,
        });

        const sendEvent = (eventName, params = {}) => {
          const payload = enrich(params);
          if (config.gtmId) {
            window.dataLayer.push({ event: eventName, ...payload });
          }
          if (config.ga4Id && typeof window.gtag === 'function') {
            window.gtag('event', eventName, payload);
          }
        };

        let lastPageView = '';
        const sendPageView = () => {
          const key = `${window.location.pathname}${window.location.search}`;
          if (lastPageView === key) return;
          lastPageView = key;
          if (config.gtmId) {
            window.dataLayer.push({ event: 'page_view', ...enrich() });
          }
          if (config.ga4Id && typeof window.gtag === 'function') {
            window.gtag('config', config.ga4Id, {
              page_location: window.location.href,
              page_path: window.location.pathname,
              page_title: document.title,
              send_page_view: true,
            });
          }
        };

        document.addEventListener('astro:page-load', sendPageView);
        if (document.readyState !== 'loading') sendPageView();
        else document.addEventListener('DOMContentLoaded', sendPageView, { once: true });

        if (window.__YANGHUA_TRACKING_BOUND__) return;
        window.__YANGHUA_TRACKING_BOUND__ = true;

        document.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('a,button') : null;
          if (!(link instanceof HTMLElement)) return;

          const href = link instanceof HTMLAnchorElement ? link.href : '';
          const label = (link.textContent || link.getAttribute('aria-label') || '').trim().slice(0, 120);
          const params = { link_url: href, link_text: label };

          if (/wa\.me|whatsapp/i.test(href)) sendEvent('click_whatsapp', params);
          else if (href.startsWith('mailto:')) sendEvent('click_email', params);
          else if (href.startsWith('tel:')) sendEvent('click_phone', params);
          else if (/\.(pdf|zip|docx?|xlsx?|pptx?)($|\?)/i.test(href)) sendEvent('click_download', params);
          else if (/contact|quote|inquiry|product|solution/i.test(href + ' ' + label)) sendEvent('click_cta', params);
          else if (link instanceof HTMLAnchorElement && link.origin && link.origin !== window.location.origin) sendEvent('outbound_click', params);
        });

        document.addEventListener('focusin', (event) => {
          const form = event.target instanceof Element ? event.target.closest('form') : null;
          if (!(form instanceof HTMLFormElement) || form.dataset.analyticsStarted === 'true') return;
          form.dataset.analyticsStarted = 'true';
          sendEvent('form_start', { form_name: form.id || form.getAttribute('name') || 'unknown' });
        });

        document.addEventListener('submit', (event) => {
          const form = event.target;
          if (!(form instanceof HTMLFormElement)) return;
          sendEvent('form_submit', { form_name: form.id || form.getAttribute('name') || 'unknown' });
        });
      })();
    </script>
    <ClientRouter />
  </head>

  <body class="bg-background text-text font-body antialiased">
    {hasGtm && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        >
        </iframe>
      </noscript>
    )}
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:z-[99999] focus:bg-primary focus:text-primary-fg focus:px-4 focus:py-2 focus:rounded-md"
      href="#main"
    >
      Skip to main content
    </a>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
