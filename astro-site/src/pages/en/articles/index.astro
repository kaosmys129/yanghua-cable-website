---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import { loadMessages } from '../../../lib/yanghua/loaders';
import { t } from '../../../lib/yanghua/t';
import { getArticles, getHubs } from '../../../lib/yanghua/articles.mjs';
import { generateCollectionPageSchema } from '../../../lib/schema-utils';
import type { CollectionPageArticle } from '../../../lib/schema-utils';

const messages = await loadMessages('en');
const articles = getArticles('en');
const hubs = getHubs('en');
const pageTitle = t(messages, 'articles.page.title', 'Articles');
const pageDescription = t(
  messages,
  'articles.page.description',
  'Technical articles, GEO-ready guides, FAQs, and application insights for flexible busbar, energy storage, solar PV, EV charging, and high-current power distribution projects.'
);

const buyerIntentLabels: Record<string, string> = {
  awareness: 'Awareness',
  comparison: 'Comparison',
  selection: 'Selection',
  procurement: 'Procurement',
};

const collectionArticles: CollectionPageArticle[] = articles.map((a) => ({
  title: a.title,
  description: a.summary || a.description || '',
  url: a.url,
  image: a.cover?.src || undefined,
  publishedAt: a.publishedAt || undefined,
  geoQueries: a.geo?.targetQueries || [],
}));
const collectionPageSchema = generateCollectionPageSchema(collectionArticles, undefined, 'en');
---

<BaseLayout title={pageTitle} description={pageDescription} schema={collectionPageSchema}>
  <Header slot="header" locale="en" />
  <Banner title={pageTitle} locale="en" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-text-muted leading-relaxed">{pageDescription}</p>
      </div>

      {hubs.length > 0 && (
        <nav class="mt-8 flex flex-wrap justify-center gap-2" aria-label="Article hubs">
          {hubs.map((hub) => (
            <a href={hub.url} class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-medium text-text-muted transition hover:border-accent hover:text-accent">
              {hub.title}
            </a>
          ))}
        </nav>
      )}

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((a) => (
          <a href={a.url} class="group overflow-hidden rounded-lg border border-border bg-surface shadow-sm transition hover:shadow-md">
            <div class="h-44 overflow-hidden bg-background">
              {a.cover.src ? (
                <img src={a.cover.src} alt={a.cover.alt || a.title} referrerpolicy="no-referrer" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" onerror="this.style.display='none'" />
              ) : (
                <div class="flex h-full items-center justify-center text-sm text-text-muted">No image</div>
              )}
            </div>
            <div class="p-6">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                {a.geo.targetQueries.length > 0 && (
                  <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-amber-700">
                    GEO · {a.geo.targetQueries.length}Q
                  </span>
                )}
                {a.geo.buyerIntent && (
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-500">
                    {buyerIntentLabels[a.geo.buyerIntent] || a.geo.buyerIntent}
                  </span>
                )}
                {a.translationKey && (
                  <span class="rounded-full bg-surface px-2 py-0.5 text-[10px] font-medium text-text-muted ring-1 ring-border">
                    EN/ES paired
                  </span>
                )}
              </div>
              <h3 class="font-heading text-lg font-semibold text-text">{a.title}</h3>
              {a.publishedAt && <p class="mt-1 text-xs text-text-muted">{a.publishedAt}</p>}
              {a.summary && <p class="mt-3 line-clamp-3 text-sm text-text-muted">{a.summary}</p>}
              {a.geo.targetQueries[0] && (
                <p class="mt-3 rounded-md bg-background px-3 py-2 text-xs font-medium text-text-muted">
                  Target question: {a.geo.targetQueries[0]}
                </p>
              )}
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                Read
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" locale="en" />
</BaseLayout>
