---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../../../../yanghua-b2b-website/content/articles/en/*.mdx');
  return Object.keys(modules).map((path) => ({
    params: { slug: path.split('/').pop().replace(/\.mdx$/, '') },
    props: { path },
  }));
}

const modules = import.meta.glob('../../../../../yanghua-b2b-website/content/articles/en/*.mdx');
const { path } = Astro.props as { path: string };
const mod: any = await (modules as any)[path]();
const Content = mod.default;
const fm = mod.frontmatter ?? {};
const title = fm.metaTitle ?? fm.title ?? Astro.params.slug;
const description = fm.metaDescription ?? fm.summary ?? '';
const coverImage = fm.cover?.src ?? '';
const coverAlt = fm.cover?.alt ?? title;
const date = fm.publishedAt ?? '';
---

<BaseLayout title={title} description={description}>
  <Header slot="header" locale="en" />
  <Banner title={title} locale="en" />

  {coverImage && (
    <div class="mx-auto max-w-site px-4 sm:px-6 -mt-4">
      <img
        src={coverImage}
        alt={coverAlt}
        class="w-full rounded-lg object-cover max-h-[480px] shadow-md"
      />
    </div>
  )}

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      {date && <p class="text-sm text-text-muted mb-6">{date}</p>}
      <article class="prose prose-slate max-w-none">
        <Content />
      </article>
    </div>
  </section>

  <Footer slot="footer" locale="en" />
</BaseLayout>
