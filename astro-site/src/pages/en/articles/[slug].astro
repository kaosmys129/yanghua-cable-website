---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SeoPathways from '../../../components/SeoPathways.astro';
import { getAllArticles, getArticleStaticPaths, YANGHUA_SITE_URL } from '../../../lib/yanghua/articles.mjs';
import { buildArticleHreflangAlternates } from '../../../lib/yanghua/articles-core.mjs';
import { buildArticlePathways, getRelatedArticles } from '../../../lib/yanghua/content-governance';
import type { Locale } from '../../../lib/yanghua/loaders';

export function getStaticPaths() {
  return getArticleStaticPaths('en');
}

const { article, Content } = Astro.props as { article: any; Content: any };
const allArticles = getAllArticles();
const translation = article.translationKey
  ? allArticles.find((item: any) => item.translationKey === article.translationKey && item.locale !== article.locale)
  : null;

const availableLocales = Array.from(
  new Set([
    article.locale,
    ...(article.translationKey
      ? allArticles
          .filter((a: any) => a.translationKey === article.translationKey)
          .map((a: any) => a.locale)
      : []),
  ])
) as Locale[];
const alternates = buildArticleHreflangAlternates(article, allArticles, YANGHUA_SITE_URL);

const geo = article.geo;
const hasGeo = geo.targetQueries.length > 0 || geo.answerSummary || geo.citations.length > 0;
const title = article.seo.title || article.title;
const description = article.seo.description || article.description || article.summary;
const coverImage = article.cover.src || '/images/no-image-available.webp';
const coverImageUrl = new URL(coverImage, YANGHUA_SITE_URL).toString();
const coverAlt = article.cover.alt || title;
const sourceItems = geo.citations.length > 0
  ? geo.citations
  : article.sourceUrl
    ? [{ label: 'Original Yanghua source', url: article.sourceUrl, note: 'Legacy source reference' }]
    : [];
const relatedArticles = getRelatedArticles(article, allArticles, 4);
const pathways = buildArticlePathways(article, 'en');
const translationLabel = translation?.locale === 'pt' ? 'Portuguese version' : translation?.locale === 'es' ? 'Spanish version' : 'Translated version';

const buyerIntentLabels: Record<string, string> = {
  awareness: 'Awareness',
  comparison: 'Comparison',
  selection: 'Selection guide',
  procurement: 'Procurement',
};


const statusLabels: Record<string, string> = {
  legacy: 'Legacy article',
  approved: 'Approved',
  published: 'Published',
};

const faqSchema = geo.faqs.length > 0 ? {
  '@type': 'FAQPage',
  '@id': `${Astro.url}#geo-faq`,
  mainEntity: geo.faqs.map((faq: any) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: article.title,
      description,
      image: coverImageUrl,
      datePublished: article.publishedAt || undefined,
      dateModified: article.updatedAt || article.publishedAt || undefined,
      author: {
        '@type': 'Organization',
        name: article.author.name || 'Yanghua Editorial Team',
        url: 'https://www.yhflexiblebusbar.com/en/about',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Yanghua Cable',
        url: 'https://www.yhflexiblebusbar.com',
      },
      mainEntityOfPage: `https://www.yhflexiblebusbar.com${article.url}`,
      about: geo.targetQueries,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.yhflexiblebusbar.com/en' },
        { '@type': 'ListItem', position: 2, name: 'Articles', item: 'https://www.yhflexiblebusbar.com/en/articles' },
        { '@type': 'ListItem', position: 3, name: article.title, item: `https://www.yhflexiblebusbar.com${article.url}` },
      ],
    },
    ...(faqSchema ? [faqSchema] : []),
  ],
};
---

<BaseLayout
  locale="en"
  title={title}
  description={description}
  image={coverImageUrl}
  schema={structuredData}
  availableLocales={availableLocales}
  alternates={alternates}
>
  <Header slot="header" locale="en" alternates={alternates} />
  <Breadcrumbs
    locale="en"
    items={[
      { name: 'Home', href: '/en' },
      { name: 'Technical Articles', href: '/en/articles' },
      { name: article.title, current: true },
    ]}
  />
  <Banner title={title} locale="en" />

  <section class="border-b border-border bg-surface">
    <div class="mx-auto grid max-w-site gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div>
        <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wide text-text-muted">
          <span>Engineering article</span>
          {geo.buyerIntent && <span>{buyerIntentLabels[geo.buyerIntent] || geo.buyerIntent}</span>}
          <span>{statusLabels[article.geoflow.status] || article.geoflow.status}</span>
        </div>
        {description && <p class="mt-4 max-w-3xl text-base leading-7 text-text-muted">{description}</p>}
        {translation && (
          <a href={translation.url} class="mt-4 inline-flex text-sm font-semibold text-accent">
            {translationLabel}
          </a>
        )}
      </div>

      <div class="overflow-hidden rounded-lg border border-border bg-background">
        <img src={coverImage} alt={coverAlt} class="aspect-video h-full w-full object-cover" loading="eager" onerror={`if (!this.dataset.fallbackApplied) { this.dataset.fallbackApplied = 'true'; this.src = '/images/no-image-available.webp'; }`} />
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_300px]">
      <div class="min-w-0">
        {geo.answerSummary && (
          <section class="mb-8 border-l-4 border-accent bg-surface px-5 py-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Direct AI Answer</p>
            <p class="mt-3 text-base leading-7 text-text">{geo.answerSummary}</p>
          </section>
        )}

        <article class="prose prose-slate max-w-none geo-article">
          <Content />
        </article>

        {geo.faqs.length > 0 && (
          <section id="geo-faq" class="mt-10 border-t border-border pt-8">
            <h2 class="font-heading text-2xl font-semibold text-text">FAQ</h2>
            <div class="mt-5 space-y-4">
              {geo.faqs.map((faq: any) => (
                <details class="rounded-lg border border-border bg-surface p-4">
                  <summary class="cursor-pointer font-semibold text-text">{faq.question}</summary>
                  <p class="mt-3 text-sm leading-6 text-text-muted">{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
        {hasGeo && (
          <section class="rounded-lg border border-border bg-surface p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">GEO Signals</p>
            {geo.targetQueries.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {geo.targetQueries.slice(0, 10).map((query: string) => (
                  <span class="rounded-full bg-background px-3 py-1 text-xs font-medium text-text-muted ring-1 ring-border">
                    {query}
                  </span>
                ))}
              </div>
            )}
          </section>
        )}

        {sourceItems.length > 0 && (
          <section class="rounded-lg border border-border bg-surface p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">GEO Sources</p>
            <ul class="mt-4 space-y-3 text-sm leading-6">
              {sourceItems.slice(0, 6).map((source: any) => (
                <li>
                  {source.url ? (
                    <a href={source.url} class="font-medium text-accent underline underline-offset-4" target="_blank" rel="noreferrer">
                      {source.label || source.url}
                    </a>
                  ) : (
                    <span class="font-medium text-text">{source.label}</span>
                  )}
                  {source.note && <p class="mt-1 text-xs text-text-muted">{source.note}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {pathways.length > 0 && (
          <section class="rounded-lg border border-border bg-surface p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Related Buying Paths</p>
            <div class="mt-4 space-y-2">
              {pathways.slice(0, 4).map((item: any) => (
                <a href={item.href} class="block rounded-md bg-background px-3 py-2 text-sm font-medium text-text transition hover:text-accent">
                  {item.label}
                </a>
              ))}
            </div>
          </section>
        )}

        {relatedArticles.length > 0 && (
          <section class="rounded-lg border border-border bg-surface p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Related Technical Reading</p>
            <div class="mt-4 space-y-3">
              {relatedArticles.map((related: any) => (
                <a href={related.url} class="block rounded-md bg-background px-3 py-3 transition hover:text-accent">
                  <span class="block text-sm font-semibold text-text">{related.title}</span>
                  {related.summary && <span class="mt-1 block text-xs leading-5 text-text-muted">{related.summary}</span>}
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="rounded-lg border border-border bg-surface p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Review Snapshot</p>
          <dl class="mt-4 space-y-3 text-sm">
            {article.updatedAt && (
              <div>
                <dt class="text-xs font-medium text-text-muted">Updated</dt>
                <dd class="mt-0.5 text-text">{article.updatedAt}</dd>
              </div>
            )}
            <div>
              <dt class="text-xs font-medium text-text-muted">Author</dt>
              <dd class="mt-0.5 text-text">{article.author.name}</dd>
            </div>
            {article.geoflow.reviewedBy && (
              <div>
                <dt class="text-xs font-medium text-text-muted">Reviewed by</dt>
                <dd class="mt-0.5 text-text">{article.geoflow.reviewedBy}</dd>
              </div>
            )}
            {article.geoflow.sourceBatchId && (
              <div>
                <dt class="text-xs font-medium text-text-muted">Batch</dt>
                <dd class="mt-0.5 text-text">{article.geoflow.sourceBatchId}</dd>
              </div>
            )}
          </dl>
        </section>
      </aside>
    </div>
  </section>

  <SeoPathways links={pathways} />

  <Footer slot="footer" locale="en" />
</BaseLayout>

<style>
  article.geo-article table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  article.geo-article thead {
    background-color: #f1f5f9;
  }

  article.geo-article th,
  article.geo-article td {
    border-bottom: 1px solid #e2e8f0;
    padding: 0.75rem 1rem;
    text-align: left;
    vertical-align: top;
  }

  article.geo-article blockquote {
    border-left: 4px solid var(--color-accent);
    background-color: #fffbeb;
    border-radius: 0 0.5rem 0.5rem 0;
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
  }

  article.geo-article p img {
    border-radius: 0.5rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
    margin: 1.5rem 0;
  }
</style>
