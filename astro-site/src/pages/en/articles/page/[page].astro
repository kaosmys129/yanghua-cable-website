---
export const prerender = true;
import ArticleListingPage from '../../../../components/ArticleListingPage.astro';
import { getArticles } from '../../../../lib/yanghua/articles.mjs';
import { getTotalPages } from '../../../../lib/yanghua/pagination';

export function getStaticPaths() {
  const totalPages = getTotalPages(getArticles('en').length);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const pageNumber = Number(Astro.params.page || '2');
---

<ArticleListingPage locale="en" pageNumber={pageNumber} />
