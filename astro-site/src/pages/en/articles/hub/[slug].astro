---
export const prerender = true;
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Banner from '../../../../components/Banner.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SeoPathways from '../../../../components/SeoPathways.astro';
import { getArticles, getHubStaticPaths } from '../../../../lib/yanghua/articles.mjs';
import { buildHubPathways, getRelatedArticles } from '../../../../lib/yanghua/content-governance';

export function getStaticPaths() {
  return getHubStaticPaths('en');
}

const { hub, Content } = Astro.props as { hub: any; Content: any };
const articles = getArticles('en');
const featuredArticles = hub.featuredArticleSlugs
  .map((slug: string) => articles.find((article: any) => article.slug === slug))
  .filter(Boolean);
const relatedArticles = featuredArticles.length >= 4
  ? featuredArticles
  : getRelatedArticles({ slug: hub.slug, title: hub.title, url: hub.url, locale: 'en', description: hub.description }, articles, 6);
const pathways = buildHubPathways(hub, 'en');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: hub.title,
  description: hub.description,
  url: `https://www.yhflexiblebusbar.com${hub.url}`,
  hasPart: featuredArticles.map((article: any) => ({
    '@type': 'BlogPosting',
    headline: article.title,
    url: `https://www.yhflexiblebusbar.com${article.url}`,
  })),
};
---

<BaseLayout locale="en" title={hub.title} description={hub.description} schema={structuredData}>
  <Header slot="header" locale="en" />
  <Breadcrumbs
    locale="en"
    items={[
      { name: 'Home', href: '/en' },
      { name: 'Technical Articles', href: '/en/articles' },
      { name: 'Article Hubs', href: '/en/articles/hub' },
      { name: hub.title, current: true },
    ]}
  />
  <Banner title={hub.title} locale="en" />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_320px]">
      <article class="prose prose-slate max-w-none">
        <Content />
      </article>

      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <section class="rounded-lg border border-border bg-surface p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Featured Articles</p>
          <div class="mt-4 space-y-3">
            {relatedArticles.map((article: any) => (
              <a href={article.url} class="block rounded-md bg-background px-3 py-3 transition hover:text-accent">
                <span class="block text-sm font-semibold text-text">{article.title}</span>
                {article.geo.targetQueries[0] && (
                  <span class="mt-1 block text-xs text-text-muted">{article.geo.targetQueries[0]}</span>
                )}
              </a>
            ))}
            {relatedArticles.length === 0 && (
              <p class="text-sm text-text-muted">Related articles will appear here after review.</p>
            )}
          </div>
        </section>
        <section class="rounded-lg border border-border bg-surface p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Project Pathways</p>
          <div class="mt-4 space-y-2">
            {pathways.map((link) => (
              <a href={link.href} class="block rounded-md bg-background px-3 py-2 text-sm font-medium text-text transition hover:text-accent">{link.label}</a>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </section>

  <SeoPathways links={pathways} title="Apply this topic to your project" />

  <Footer slot="footer" locale="en" />
</BaseLayout>
