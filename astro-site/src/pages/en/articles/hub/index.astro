---
export const prerender = true;
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Banner from '../../../../components/Banner.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SeoPathways from '../../../../components/SeoPathways.astro';
import { getHubs } from '../../../../lib/yanghua/articles.mjs';

const hubs = getHubs('en');
---

<BaseLayout title="Article Hubs" description="Topic hubs for flexible busbar selection, high-current power distribution, data centers, energy storage, EV charging, and industrial retrofit projects.">
  <Header slot="header" locale="en" />
  <Breadcrumbs locale="en" items={[{ name: 'Home', href: '/en' }, { name: 'Technical Articles', href: '/en/articles' }, { name: 'Article Hubs', current: true }]} />
  <Banner title="Article Hubs" locale="en" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mt-2 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {hubs.map((h) => (
          <a href={h.url} class="rounded-lg border border-border bg-surface p-6 shadow-sm transition hover:shadow-md">
            <h3 class="font-heading text-lg font-semibold text-text">{h.title}</h3>
            {h.description && <p class="mt-2 text-sm text-text-muted">{h.description}</p>}
            {h.featuredArticleSlugs.length > 0 && (
              <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-accent">
                {h.featuredArticleSlugs.length} featured articles
              </p>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <SeoPathways
    title="Start with a commercial topic"
    description="Use a topic hub to compare technical options, review project evidence, and reach the relevant product or solution page."
    links={[
      { kind: 'solution', href: '/en/solutions/data-center', label: 'Data center solution' },
      { kind: 'solution', href: '/en/solutions/new-energy', label: 'New energy solution' },
      { kind: 'product', href: '/en/products', label: 'Flexible busbar products' },
      { kind: 'contact', href: '/en/contact', label: 'Request an engineering quotation' },
    ]}
  />

  <Footer slot="footer" locale="en" />
</BaseLayout>
