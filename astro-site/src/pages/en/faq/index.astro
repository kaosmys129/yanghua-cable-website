---
export const prerender = true;
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import CTA from '../../../components/CTA.astro';
import { generateFAQSchema } from '../../../lib/schema-utils';
import { repoRoot } from '../../../lib/yanghua/paths';

let faqs: Array<{ question: string; answer: string }> = [];

try {
  // Read the generated JSON file from the sub-agent
  const jsonPath = path.join(repoRoot, 'exports', 'geo-knowledge-base', 'faq_en.json');
  if (fs.existsSync(jsonPath)) {
    faqs = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
  }
} catch (e) {
  console.error('Error loading FAQ JSON:', e);
}

const schema = faqs.length > 0 ? generateFAQSchema(faqs) : undefined;
---

<BaseLayout title="Frequently Asked Questions - Yanghua Cable" description="Find answers to common questions about flexible busbar, installation, technical specs, and application scenarios." schema={schema}>
  <Header slot="header" locale="en" />

  <Banner title="Frequently Asked Questions" locale="en" />

  <section class="py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      {faqs.length > 0 ? (
        <div class="space-y-6">
          {faqs.map((faq) => (
            <details class="group rounded-lg border border-border bg-surface p-6 shadow-sm open:ring-2 open:ring-primary/20">
              <summary class="flex cursor-pointer items-center justify-between font-heading text-lg font-semibold text-text">
                {faq.question}
                <span class="ml-4 flex-shrink-0 text-primary transition-transform group-open:rotate-180">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 text-text-muted prose prose-sm max-w-none" set:html={faq.answer} />
            </details>
          ))}
        </div>
      ) : (
        <div class="text-center py-12 text-text-muted">
          <p>Our comprehensive FAQ library is currently being compiled. Please check back soon.</p>
        </div>
      )}
    </div>
  </section>

  <CTA 
    title="Still have questions?"
    description="Our technical team is ready to provide tailored solutions for your project."
    buttonText="Contact Support"
    buttonHref="/en/contact"
  />

  <Footer slot="footer" locale="en" />
</BaseLayout>
