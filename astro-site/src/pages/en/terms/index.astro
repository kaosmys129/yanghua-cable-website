---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import { loadPageJson } from '../../../lib/yanghua/loaders';

const page = await loadPageJson<any>('en', 'terms');
---

<BaseLayout title="Terms of Service" description="">
  <Header slot="header" locale="en" />
  <Banner title="Terms of Service" locale="en" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="rounded-lg border border-border bg-surface p-8 text-text-muted">
        Terms content is currently empty in `content/pages/en/terms.json` (legacy site). Add content there and it will be rendered here.
      </div>
      {page?.content && Object.keys(page.content).length > 0 && (
        <pre class="mt-8 overflow-auto rounded-lg border border-border bg-background p-6 text-xs text-text">
          {JSON.stringify(page.content, null, 2)}
        </pre>
      )}
    </div>
  </section>

  <Footer slot="footer" locale="en" />
</BaseLayout>

