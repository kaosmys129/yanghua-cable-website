---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import CTA from '../../../components/CTA.astro';
import AboutProductionSections from '../../../components/AboutProductionSections.astro';
import { loadPageJson } from '../../../lib/yanghua/loaders';
import { route } from '../../../lib/yanghua/routes';

const page = await loadPageJson<any>('en', 'about');
const content = page?.content ?? {};
---

<BaseLayout title={content?.hero?.title ?? 'About'} description={content?.hero?.subtitle ?? ''}>
  <Header slot="header" locale="en" />

  <Banner title={content?.hero?.title ?? 'About'} locale="en" />

  <AboutProductionSections content={content} locale="en" />

  <CTA
    title={content?.cta?.title ?? 'Ready to Partner with Us?'}
    description={content?.cta?.description ?? content?.cta?.subtitle ?? ''}
    buttonText={content?.cta?.buttons?.contact ?? 'Contact'}
    buttonHref={route('contact', 'en')}
    showPhone={false}
  />

  <Footer slot="footer" locale="en" />
</BaseLayout>
