---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import CTA from '../../../components/CTA.astro';
import { loadPageJson } from '../../../lib/yanghua/loaders';
import { route } from '../../../lib/yanghua/routes';

const page = await loadPageJson<any>('en', 'partners');
const content = page?.content ?? {};
---

<BaseLayout title={content?.title ?? 'Partners'} description={content?.subtitle ?? ''}>
  <Header slot="header" locale="en" />
  <Banner title={content?.title ?? 'Partners'} locale="en" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">{content?.title}</h2>
        <p class="mt-3 text-text-muted leading-relaxed">{content?.subtitle}</p>
      </div>
      <div class="mt-10 rounded-lg border border-border bg-surface p-8 text-center text-text-muted">
        Partner list assets will be connected next (reusing existing brand images).
      </div>
    </div>
  </section>

  <CTA
    title={content?.title ?? 'Our Partners'}
    description={content?.subtitle ?? ''}
    buttonText={content?.ctaAllPartners ?? 'Get Quote'}
    buttonHref={route('contact', 'en')}
  />

  <Footer slot="footer" locale="en" />
</BaseLayout>

