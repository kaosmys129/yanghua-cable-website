---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTA from '../../../components/CTA.astro';
import SeoPathways from '../../../components/SeoPathways.astro';
import { loadMessages } from '../../../lib/yanghua/loaders';
import { t, tRaw } from '../../../lib/yanghua/t';
import { route } from '../../../lib/yanghua/routes';

const messages = await loadMessages('en');
const solutions = tRaw<any[]>(messages, 'solutions.solutions', []);
---

<BaseLayout title={t(messages, 'solutions.page.title')} description={t(messages, 'solutions.page.description')}>
  <Header slot="header" locale="en" />
  <Breadcrumbs locale="en" items={[{ name: 'Home', href: '/en' }, { name: 'Solutions', current: true }]} />
  <Banner title={t(messages, 'solutions.page.title')} locale="en" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-text-muted leading-relaxed">{t(messages, 'solutions.page.description')}</p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {solutions.map((s) => (
          <a href={`/en/solutions/${s.id}`} class="group overflow-hidden rounded-lg border border-border bg-surface shadow-sm transition hover:shadow-md">
            <div class="h-44 overflow-hidden bg-background">
              <img src={s.image} alt={s.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="p-6">
              <h3 class="font-heading text-lg font-semibold text-text">{s.title}</h3>
              <p class="mt-2 text-sm text-text-muted">{s.subtitle}</p>
              <p class="mt-3 line-clamp-3 text-sm text-text-muted">{s.description}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                {t(messages, 'solutions.common.viewDetails')}
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title={t(messages, 'solutions.cta.customSolution.title')}
    description={t(messages, 'solutions.cta.customSolution.description')}
    buttonText={t(messages, 'solutions.common.contactUs')}
    buttonHref={route('contact', 'en')}
  />

  <SeoPathways
    title="Connect solutions to evidence and products"
    description="Review product capabilities, technical hubs, and completed project examples before requesting a tailored design."
    links={[
      { kind: 'product', href: '/en/products', label: 'Browse flexible busbar products' },
      { kind: 'project', href: '/en/projects', label: 'Review project examples' },
      { kind: 'hub', href: '/en/articles/hub/high-current-power-distribution', label: 'High-current distribution hub' },
      { kind: 'contact', href: '/en/contact', label: 'Request a tailored quotation' },
    ]}
  />

  <Footer slot="footer" locale="en" />
</BaseLayout>
