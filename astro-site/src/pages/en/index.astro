---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HeroSection from '../../components/react/HeroSection';
import TrustBarSection from '../../components/react/TrustBarSection';
import ServicesSection from '../../components/react/ServicesSection';
import AboutSection from '../../components/react/AboutSection';
import CTASection from '../../components/react/CTASection';
import ProductComparisonSection from '../../components/react/ProductComparisonSection';
import PartnersSection from '../../components/react/PartnersSection';
import ProjectGallerySection from '../../components/react/ProjectGallerySection';
import InquiryFormSection from '../../components/react/InquiryFormSection';
import { brand } from '../../config/brand';
import { client } from '../../data/client';
import { loadMessages, loadPageJson } from '../../lib/yanghua/loaders';
import { route } from '../../lib/yanghua/routes';
import { tRaw } from '../../lib/yanghua/t';

const page = await loadPageJson<any>('en', 'home');
const messages = await loadMessages('en');

const trustItems = Object.values(page?.companyStrength?.stats ?? {}).map((s: any) => ({
  value: s?.value,
  label: s?.label ?? '',
}));

const applicationAreaImages: Record<string, { image: string; imageAlt: string }> = {
  energy: {
    image: '/images/projects/50mw-solar-farm-power-distribution.webp',
    imageAlt: 'Solar facility power distribution project site',
  },
  building: {
    image: '/images/projects/metro-line-14.webp',
    imageAlt: 'Outdoor utility power distribution cabinets at a project site',
  },
  industry: {
    image: '/images/projects/midea-industrial-complex.webp',
    imageAlt: 'Industrial manufacturing complex with electrical infrastructure',
  },
  dataCenter: {
    image: '/images/projects/huawei-data-center-expansion.webp',
    imageAlt: 'Data center expansion project building and power infrastructure',
  },
  railway: {
    image: '/images/projects/metro-line-14.webp',
    imageAlt: 'Metro power distribution cabinets for rail transit infrastructure',
  },
  chemical: {
    image: '/images/projects/steel-mill-modernization.webp',
    imageAlt: 'Heavy industrial plant power distribution project site',
  },
  marine: {
    image: '/images/projects/steel-mill-modernization.webp',
    imageAlt: 'Large outdoor industrial power distribution environment',
  },
};

const services = Object.entries(page?.applicationAreas?.areas ?? {}).map(([key, a]: [string, any]) => ({
  title: a?.title ?? '',
  description: a?.description ?? '',
  href: route('solutions', 'en'),
  ...applicationAreaImages[key],
}));

const partners = [
  { name: 'BYD', logo: '/images/partners/byd.webp' },
  { name: 'CATL', logo: '/images/partners/catl.webp' },
  { name: 'Huawei', logo: '/images/partners/huawei.webp' },
  { name: 'State Grid', logo: '/images/partners/state grid.webp' },
  { name: 'Southern Power Grid', logo: '/images/partners/southern power grid.webp' },
  { name: 'Power China', logo: '/images/partners/powerchina.webp' },
];

const projects = tRaw<any[]>(messages, 'projects.list', []);
---

<BaseLayout
  title={page?.hero?.title ?? brand.name}
  description={page?.hero?.description ?? brand.description}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: client.name,
    url: client.domain,
    email: client.email,
    telephone: client.phoneForTel,
  }}
>
  <Header slot="header" locale="en" />

  <HeroSection
    topper={page?.hero?.subtitle}
    heading={page?.hero?.title}
    description={page?.hero?.description}
    ctaLabel={page?.hero?.cta}
    ctaHref={route('products', 'en')}
    secondaryLabel={page?.hero?.learnMore}
    secondaryHref={route('about', 'en')}
    phone={client.phoneFormatted}
    phoneHref={`tel:${client.phoneForTel}`}
  />

  {trustItems.length > 0 && <TrustBarSection items={trustItems} />}

  <ServicesSection
    topper={page?.applicationAreas?.title}
    heading={page?.applicationAreas?.title}
    description={page?.applicationAreas?.subtitle}
    services={services}
  />

  <AboutSection
    topper={page?.companyStrength?.title}
    heading={page?.companyStrength?.title}
    body={[page?.companyStrength?.subtitle].filter(Boolean)}
    benefits={Object.values(page?.companyStrength?.stats ?? {}).map((s: any) => s?.description).filter(Boolean)}
    ctaLabel={page?.companyStrength?.ctaLearnMore}
    ctaHref={route('about', 'en')}
  />

  <ProductComparisonSection content={tRaw(messages, 'flexibleBusbarComparison', {})} locale="en" />

  <PartnersSection title={page?.partners?.title} subtitle={page?.partners?.subtitle} partners={partners} />

  <ProjectGallerySection content={tRaw(messages, 'projectGallery', {})} projects={projects} locale="en" />

  <InquiryFormSection client:load content={tRaw(messages, 'inquiry', {})} locale="en" />

  <CTASection
    title="Ready to Get Started?"
    description="Contact us for product selection, technical support, and quotations."
    buttonText="Get Quote"
    buttonHref={route('contact', 'en')}
    phone={client.phoneFormatted}
    phoneHref={`tel:${client.phoneForTel}`}
  />

  <Footer slot="footer" locale="en" />
</BaseLayout>
