---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import CTA from '../../../components/CTA.astro';
import ProductCategories from '../../../components/ProductCategories.astro';
import TechnicalSpecs from '../../../components/TechnicalSpecs.astro';
import FAQSection from '../../../components/FAQSection.astro';
import { loadMessages } from '../../../lib/yanghua/loaders';
import { route } from '../../../lib/yanghua/routes';
import { t, tRaw } from '../../../lib/yanghua/t';

const messages = await loadMessages('es');

const featureCards = tRaw<Record<string, any>>(messages, 'productFeatures.cards', {});
const categories = tRaw<any[]>(messages, 'products.categories', []);
const productLabels = tRaw<Record<string, string>>(messages, 'products.common', {});
const specifications = tRaw<Record<string, any>>(messages, 'products.specifications', {});
const faqContent = tRaw<Record<string, any>>(messages, 'services.faq', {});
const faqItems = Object.values(faqContent)
  .filter((value: any) => value && typeof value === 'object' && 'question' in value && 'answer' in value)
  .map((value: any) => ({ question: value.question, answer: value.answer }));
---

<BaseLayout title={t(messages, 'products.hero.title', 'Nuestros Productos')} description={t(messages, 'products.hero.subtitle', '')}>
  <Header slot="header" locale="es" />
  <Banner title={t(messages, 'products.hero.title', 'Productos')} locale="es" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">{t(messages, 'products.overview.title', 'Descripción de Productos')}</h2>
        <p class="mt-3 text-text-muted">{t(messages, 'products.overview.subtitle', t(messages, 'products.hero.subtitle', ''))}</p>
      </div>
    </div>
  </section>

  <ProductCategories categories={categories} labels={productLabels} locale="es" />

  <TechnicalSpecs specs={specifications} />

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">{t(messages, 'productFeatures.title')}</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">{t(messages, 'productFeatures.title')}</h2>
        <p class="mt-3 text-text-muted">{t(messages, 'productFeatures.subtitle')}</p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {Object.values(featureCards).map((c: any) => (
          <div class="rounded-lg border border-border bg-background p-6 shadow-sm">
            <h3 class="font-heading text-lg font-semibold text-text">{c?.title}</h3>
            <p class="mt-2 text-sm text-text-muted">{c?.description}</p>
            {c?.details && (
              <ul class="mt-4 space-y-1.5 text-sm text-text-muted">
                {Object.values(c.details).map((d: any) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1 inline-block size-1.5 rounded-full bg-accent"></span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQSection
    topper="FAQ"
    title={faqContent?.title ?? 'Preguntas Frecuentes'}
    description="Respuestas a preguntas comunes sobre selección de productos, certificaciones, soporte de instalación y pedidos personalizados."
    items={faqItems}
  />

  <CTA
    title="¿Necesita una recomendación?"
    description="Cuéntenos su escenario de aplicación y le recomendaremos productos adecuados."
    buttonText="Contacto"
    buttonHref={route('contact', 'es')}
  />

  <Footer slot="footer" locale="es" />
</BaseLayout>
