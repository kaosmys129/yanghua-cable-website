---
export const prerender = true;
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Banner from '../../../../components/Banner.astro';
import ProductCategoryDetail from '../../../../components/ProductCategoryDetail.astro';
import { loadMessages } from '../../../../lib/yanghua/loaders';
import { tRaw } from '../../../../lib/yanghua/t';
import { buildProductCategories, findProductCategory } from '../../../../lib/yanghua/products';
import { buildProductCategoryAlternates } from '../../../../lib/yanghua/seo-localized-routes.mjs';

export async function getStaticPaths() {
  const messages = await loadMessages('es');
  const categories = buildProductCategories('es', tRaw<any[]>(messages, 'products.categories', []));
  return categories.map((category) => ({ params: { name: category.slug }, props: { categoryData: category } }));
}
const messages = await loadMessages('es');
const categories = buildProductCategories('es', tRaw<any[]>(messages, 'products.categories', []));
const category = Astro.props.categoryData ?? findProductCategory(categories, Astro.params.name ?? '');

if (!category) {
  return Astro.redirect('/es/productos', 302);
}
const alternates = buildProductCategoryAlternates('es', category.slug);
---

<BaseLayout title={`${category.name} | Categoría de Barra Colectora Flexible | Yanghua`} description={`Descubra modelos, estructura y especificaciones de ${category.name} en barras colectoras flexibles para diversas aplicaciones.`} alternates={alternates}>
  <Header slot="header" locale="es" alternates={alternates} />
  <Banner title={`${category.name}`} locale="es" />
  <ProductCategoryDetail category={category} locale="es" />
  <Footer slot="footer" locale="es" />
</BaseLayout>
