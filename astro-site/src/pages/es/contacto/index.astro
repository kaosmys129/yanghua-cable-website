---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import { loadPageJson } from '../../../lib/yanghua/loaders';

const page = await loadPageJson<any>('es', 'contact');
const content = page?.content ?? {};
const form = content?.form ?? {};
const labels = form?.labels ?? {};
const placeholders = form?.placeholders ?? {};
const subjects = form?.subjects ?? {};
---

<BaseLayout title={content?.page?.title ?? 'Contacto'} description={content?.page?.description ?? ''}>
  <Header slot="header" locale="es" />

  <Banner title={content?.page?.title ?? 'Contacto'} locale="es" />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-5 lg:gap-14">
      <div class="lg:col-span-3">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">{content?.sections?.getInTouch ?? 'Ponte en contacto'}</h2>
        <p class="mt-2 mb-8 text-text-muted">{content?.page?.description ?? ''}</p>

        <form id="contact-form" class="flex flex-col gap-5">
          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">{labels.name} <span class="text-accent" aria-hidden="true">*</span></span>
            <input type="text" name="name" required placeholder={placeholders.name}
              class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">{labels.email} <span class="text-accent" aria-hidden="true">*</span></span>
            <input type="email" name="email" required placeholder={placeholders.email}
              class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
          </label>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-medium text-text">{labels.company}</span>
              <input type="text" name="company" placeholder={placeholders.company}
                class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </label>
            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-medium text-text">{labels.country}</span>
              <input type="text" name="country" placeholder={placeholders.country}
                class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </label>
          </div>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">{labels.phone}</span>
            <input type="tel" name="phone" placeholder={placeholders.phone}
              class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">{labels.subject}</span>
            <select name="subject"
              class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
              <option value="">{subjects.selectSubject}</option>
              <option value="productInquiry">{subjects.productInquiry}</option>
              <option value="technicalSupport">{subjects.technicalSupport}</option>
              <option value="partnership">{subjects.partnership}</option>
              <option value="customSolution">{subjects.customSolution}</option>
              <option value="other">{subjects.other}</option>
            </select>
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">{labels.message} <span class="text-accent" aria-hidden="true">*</span></span>
            <textarea name="message" rows="6" required placeholder={placeholders.message}
              class="min-h-[140px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 resize-y"></textarea>
          </label>

          <p id="contact-form-status" class="hidden rounded-md border border-border bg-surface px-4 py-3 text-sm text-text-muted"></p>

          <button type="submit"
            class="mt-2 inline-flex min-h-[44px] cursor-pointer items-center justify-center self-start rounded-md bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            {form?.buttons?.submit ?? 'Enviar Mensaje'}
          </button>
        </form>
      </div>

      <aside class="space-y-8 lg:col-span-2">
        <div>
          <h3 class="font-heading text-lg font-semibold text-text">{content?.info?.phone?.title ?? 'Teléfono'}</h3>
          <p class="mt-1 text-primary-light font-medium">{content?.info?.phone?.content}</p>
          <p class="mt-1 text-sm text-text-muted">{content?.info?.phone?.description}</p>
        </div>
        <div>
          <h3 class="font-heading text-lg font-semibold text-text">{content?.info?.email?.title ?? 'Correo'}</h3>
          <p class="mt-1 text-primary-light font-medium">{content?.info?.email?.content}</p>
          <p class="mt-1 text-sm text-text-muted">{content?.info?.email?.description}</p>
        </div>
        <div>
          <h3 class="font-heading text-lg font-semibold text-text">{content?.info?.address?.title ?? 'Dirección'}</h3>
          <p class="mt-1 text-text-muted">{content?.info?.address?.content}</p>
          <p class="mt-1 text-sm text-text-muted">{content?.info?.address?.description}</p>
        </div>
        <div>
          <h3 class="font-heading text-lg font-semibold text-text">{content?.info?.hours?.title ?? 'Horario'}</h3>
          <p class="mt-1 text-text-muted">{content?.info?.hours?.content}</p>
          <p class="mt-1 text-sm text-text-muted">{content?.info?.hours?.description}</p>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" locale="es" />
</BaseLayout>

<script>
  (() => {
    const form = document.getElementById('contact-form');
    const status = document.getElementById('contact-form-status');
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

    fetch('/api/csrf', { method: 'GET', credentials: 'include' }).catch(() => {});

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      status.classList.remove('hidden');
      status.textContent = 'Enviando...';

      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());

      fetch('/api/email/send', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'Accept-Language': 'es',
        },
        body: JSON.stringify({
          ...payload,
          type: 'contact',
          locale: 'es',
        }),
      })
        .then(async (res) => {
          const data = await res.json().catch(() => ({}));
          if (res.ok && data?.success) {
            status.textContent = 'Mensaje enviado con éxito.';
            form.reset();
          } else {
            status.textContent = data?.message || data?.error || 'Error al enviar.';
          }
        })
        .catch(() => {
          status.textContent = 'Error de red. Inténtalo de nuevo más tarde.';
        });
    });
  })();
</script>
