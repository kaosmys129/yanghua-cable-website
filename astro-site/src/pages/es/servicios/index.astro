---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import Services from '../../../components/Services.astro';
import CTA from '../../../components/CTA.astro';
import { loadPageJson } from '../../../lib/yanghua/loaders';
import { route } from '../../../lib/yanghua/routes';

const page = await loadPageJson<any>('es', 'services');
const content = page?.content ?? {};

const cards =
  (content?.services ?? []).map((s: any) => ({
    title: s?.title ?? '',
    description: s?.description ?? '',
    href: route('contact', 'es'),
  })) ?? [];

const faqItems = Object.values(content?.faq ?? {})
  .filter((v: any) => v && typeof v === 'object' && 'question' in v)
  .map((v: any) => ({ q: v.question, a: v.answer }));
---

<BaseLayout title={content?.page?.title ?? 'Servicios'} description={content?.page?.description ?? ''}>
  <Header slot="header" locale="es" />

  <Banner title={content?.page?.title ?? 'Servicios'} locale="es" />

  <Services
    topper="Servicio y Soporte"
    heading={content?.page?.title ?? 'Servicios'}
    description={content?.page?.description ?? ''}
    services={cards}
  />

  {faqItems.length > 0 && (
    <section class="py-section">
      <div class="mx-auto max-w-site px-4 sm:px-6">
        <div class="mx-auto mb-10 max-w-2xl text-center">
          <h2 class="font-heading text-h2 font-bold uppercase text-text">{content?.faq?.title ?? 'Preguntas Frecuentes'}</h2>
        </div>
        <div class="mx-auto max-w-3xl space-y-4">
          {faqItems.map((item) => (
            <details class="rounded-lg border border-border bg-surface p-5">
              <summary class="cursor-pointer font-heading font-semibold text-text">{item.q}</summary>
              <p class="mt-3 text-text-muted leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA
    title={content?.cta?.title ?? '¿Necesita Soporte Técnico?'}
    description={content?.cta?.description ?? ''}
    buttonText={content?.cta?.contactSupport ?? 'Contacto'}
    buttonHref={route('contact', 'es')}
  />

  <section class="pb-section">
    <div class="mx-auto max-w-site px-4 text-center sm:px-6">
      <a href={route('products', 'es')} class="inline-flex min-h-[44px] items-center justify-center rounded-md border-2 border-primary px-6 py-3 font-bold text-primary transition-colors hover:bg-primary hover:text-primary-fg">
        {content?.cta?.downloadResources ?? 'Descargar recursos'}
      </a>
    </div>
  </section>

  <Footer slot="footer" locale="es" />
</BaseLayout>
