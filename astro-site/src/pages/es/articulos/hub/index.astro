---
export const prerender = true;
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Banner from '../../../../components/Banner.astro';
import { getHubs } from '../../../../lib/yanghua/articles.mjs';

const hubs = getHubs('es');
---

<BaseLayout
  title="Hubs de artículos"
  description="Explora hubs técnicos sobre busbar flexible, distribución de energía, almacenamiento y aplicaciones de alta corriente."
>
  <Header slot="header" locale="es" />
  <Banner title="Hubs de artículos" locale="es" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mt-2 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {hubs.map((h) => (
          <a href={h.url} class="rounded-lg border border-border bg-surface p-6 shadow-sm transition hover:shadow-md">
            <h3 class="font-heading text-lg font-semibold text-text">{h.title}</h3>
            {h.description && <p class="mt-2 text-sm text-text-muted">{h.description}</p>}
            {h.featuredArticleSlugs.length > 0 && (
              <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-accent">
                {h.featuredArticleSlugs.length} artículos destacados
              </p>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" locale="es" />
</BaseLayout>
