---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import { loadMessages } from '../../../lib/yanghua/loaders';
import { t } from '../../../lib/yanghua/t';

const messages = await loadMessages('es');

const modules = import.meta.glob('../../../../../yanghua-b2b-website/content/articles/es/*.mdx', {
  eager: true,
});

const articles = Object.entries(modules)
  .map(([path, mod]: any) => {
    const slug = path.split('/').pop().replace(/\.mdx$/, '');
    const fm = mod.frontmatter ?? {};
    return {
      slug,
      title: fm.metaTitle ?? fm.title ?? slug,
      summary: fm.summary ?? fm.metaDescription ?? '',
      publishedAt: fm.publishedAt ?? '',
      coverImage: fm.coverImage ?? '',
    };
  })
  .sort((a, b) => String(b.publishedAt).localeCompare(String(a.publishedAt)));
---

<BaseLayout title={t(messages, 'articles.page.title', 'Artículos')} description={t(messages, 'articles.page.description', '')}>
  <Header slot="header" locale="es" />
  <Banner title={t(messages, 'articles.page.title', 'Artículos')} locale="es" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-text-muted leading-relaxed">{t(messages, 'articles.page.description', '')}</p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((a) => (
          <a href={`/es/articulos/${a.slug}`} class="group overflow-hidden rounded-lg border border-border bg-surface shadow-sm transition hover:shadow-md">
            <div class="h-44 overflow-hidden bg-background">
              {a.coverImage ? (
                <img src={a.coverImage} alt={a.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
              ) : (
                <div class="flex h-full items-center justify-center text-sm text-text-muted">Sin imagen</div>
              )}
            </div>
            <div class="p-6">
              <h3 class="font-heading text-lg font-semibold text-text">{a.title}</h3>
              {a.publishedAt && <p class="mt-1 text-xs text-text-muted">{a.publishedAt}</p>}
              {a.summary && <p class="mt-3 line-clamp-3 text-sm text-text-muted">{a.summary}</p>}
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                Leer
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" locale="es" />
</BaseLayout>

