---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import { loadPageJson } from '../../../lib/yanghua/loaders';

const page = await loadPageJson<any>('es', 'terms');
---

<BaseLayout title="Términos del Servicio" description="">
  <Header slot="header" locale="es" />
  <Banner title="Términos del Servicio" locale="es" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="rounded-lg border border-border bg-surface p-8 text-text-muted">
        La publicación de términos está pendiente de aprobación. Agrega contenido aprobado en `content/pages/es/terms.json` y se mostrará aquí.
      </div>
      {page?.content && Object.keys(page.content).length > 0 && (
        <pre class="mt-8 overflow-auto rounded-lg border border-border bg-background p-6 text-xs text-text">
          {JSON.stringify(page.content, null, 2)}
        </pre>
      )}
    </div>
  </section>

  <Footer slot="footer" locale="es" />
</BaseLayout>
