---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import CTA from '../../../components/CTA.astro';
import AboutProductionSections from '../../../components/AboutProductionSections.astro';
import { loadPageJson } from '../../../lib/yanghua/loaders';
import { route } from '../../../lib/yanghua/routes';

const page = await loadPageJson<any>('pt', 'about');
const content = page?.content ?? {};
---

<BaseLayout title={content?.hero?.title ?? 'Sobre nós'} description={content?.hero?.subtitle ?? 'Conheça a Yanghua Cable, fabricante de barramentos flexíveis e soluções de distribuição de energia.'}>
  <Header slot="header" locale="pt" />

  <Banner title={content?.hero?.title ?? 'Sobre nós'} locale="pt" />

  <AboutProductionSections content={content} locale="pt" />

  <CTA
    title={content?.cta?.title ?? 'Pronto para fazer parceria conosco?'}
    description={content?.cta?.description ?? content?.cta?.subtitle ?? ''}
    buttonText={content?.cta?.buttons?.contact ?? 'Contato'}
    buttonHref={route('contact', 'pt')}
    locale="pt"
    showPhone={false}
  />

  <Footer slot="footer" locale="pt" />
</BaseLayout>
