---
export const prerender = true;
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Banner from '../../../../components/Banner.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SeoPathways from '../../../../components/SeoPathways.astro';
import { getArticles, getHubStaticPaths } from '../../../../lib/yanghua/articles.mjs';
import { buildHubPathways } from '../../../../lib/yanghua/content-governance';

export function getStaticPaths() {
  return getHubStaticPaths('pt');
}

const { hub, Content } = Astro.props as { hub: any; Content: any };
const articles = getArticles('pt');
const featuredArticles = hub.featuredArticleSlugs
  .map((slug: string) => articles.find((article: any) => article.slug === slug))
  .filter(Boolean);
const pathways = buildHubPathways(hub, 'pt');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: hub.title,
  description: hub.description,
  url: `https://www.yhflexiblebusbar.com${hub.url}`,
  hasPart: featuredArticles.map((article: any) => ({
    '@type': 'BlogPosting',
    headline: article.title,
    url: `https://www.yhflexiblebusbar.com${article.url}`,
  })),
};
---

<BaseLayout locale="pt" title={hub.title} description={hub.description} schema={structuredData}>
  <Header slot="header" locale="pt" />
  <Breadcrumbs locale="pt" items={[{ name: 'Início', href: '/pt' }, { name: 'Artigos técnicos', href: '/pt/artigos' }, { name: 'Hubs temáticos', href: '/pt/artigos/hub' }, { name: hub.title, current: true }]} />
  <Banner title={hub.title} locale="pt" />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_320px]">
      <article class="prose prose-slate max-w-none">
        <Content />
      </article>

      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <section class="rounded-lg border border-border bg-surface p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Artigos em destaque</p>
          <div class="mt-4 space-y-3">
            {featuredArticles.map((article: any) => (
              <a href={article.url} class="block rounded-md bg-background px-3 py-3 transition hover:text-accent">
                <span class="block text-sm font-semibold text-text">{article.title}</span>
                {article.geo.targetQueries[0] && (
                  <span class="mt-1 block text-xs text-text-muted">{article.geo.targetQueries[0]}</span>
                )}
              </a>
            ))}
            {featuredArticles.length === 0 && (
              <p class="text-sm text-text-muted">Os artigos relacionados aparecerão aqui após a revisão.</p>
            )}
          </div>
        </section>
        <section class="rounded-lg border border-border bg-surface p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Rotas de decisão</p>
          <div class="mt-4 space-y-2">
            {pathways.map((link) => (
              <a href={link.href} class="block rounded-md bg-background px-3 py-2 text-sm font-medium text-text transition hover:text-accent">{link.label}</a>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </section>

  <SeoPathways
    title="Leve este tema para o seu projeto"
    description="Conecte a pesquisa sobre sistemas personalizados a produtos, soluções, evidências de projetos e contato de engenharia."
    links={pathways}
  />

  <Footer slot="footer" locale="pt" />
</BaseLayout>
