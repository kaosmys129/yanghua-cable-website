---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import ProductDetailContent from '../../../components/ProductDetailContent.astro';
import { findProductDetail, getProductDetails } from '../../../lib/yanghua/products';
import { brand } from '../../../config/brand';
import { generateFullOrganizationSchema, generateProductSchema, generateBreadcrumbSchema } from '../../../lib/schema-utils';

export function getStaticPaths() {
  return getProductDetails('pt').map((product) => ({ params: { id: product.id }, props: { product } }));
}

const product = Astro.props.product ?? findProductDetail(Astro.params.id ?? '', 'pt');

if (!product) {
  return Astro.redirect('/pt/produtos', 302);
}

const related = product.relatedProducts.map((id: string) => findProductDetail(id, 'pt')).filter(Boolean);

const siteUrl = String(Astro.site ?? brand.url).replace(/\/+$/, '');
const cleanPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = `${siteUrl}${cleanPath === '/' ? '' : cleanPath}`;
const productSchema = generateProductSchema(
  {
    id: product.id,
    name: product.name,
    description: product.description,
    detailedDescription: product.detailedDescription,
    image: product.images,
    technicalSpecs: product.technicalSpecs,
    url: canonical,
    locale: 'pt',
  },
  siteUrl,
);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    generateFullOrganizationSchema(siteUrl),
    productSchema,
    generateBreadcrumbSchema(
      [
        { name: 'Início', url: `${siteUrl}/pt` },
        { name: 'Produtos', url: `${siteUrl}/pt/produtos` },
        { name: product.name, url: canonical },
      ],
      siteUrl,
    ),
  ],
};
---

<BaseLayout title={`${product.name} | Barramento flexível confiável`} description={product.description} image={product.images[0]} schema={structuredData}>
  <Header slot="header" locale="pt" />
  <Banner title={product.name} locale="pt" />
  <ProductDetailContent product={product} related={related} locale="pt" />
  <Footer slot="footer" locale="pt" />
</BaseLayout>
