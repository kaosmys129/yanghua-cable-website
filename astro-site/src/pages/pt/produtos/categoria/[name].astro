---
export const prerender = true;
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Banner from '../../../../components/Banner.astro';
import ProductCategoryDetail from '../../../../components/ProductCategoryDetail.astro';
import { loadMessages } from '../../../../lib/yanghua/loaders';
import { tRaw } from '../../../../lib/yanghua/t';
import { buildProductCategories, findProductCategory } from '../../../../lib/yanghua/products';
import { buildProductCategoryAlternates } from '../../../../lib/yanghua/seo-localized-routes.mjs';

export async function getStaticPaths() {
  const messages = await loadMessages('pt');
  const categories = buildProductCategories('pt', tRaw<any[]>(messages, 'products.categories', []));
  return categories.map((category) => ({ params: { name: category.slug }, props: { category } }));
}
const messages = await loadMessages('pt');
const categories = buildProductCategories('pt', tRaw<any[]>(messages, 'products.categories', []));
const category = Astro.props.category ?? findProductCategory(categories, Astro.params.name ?? '');

if (!category) {
  return Astro.redirect('/pt/produtos', 302);
}
const alternates = buildProductCategoryAlternates('pt', category.slug);
---

<BaseLayout title={`${category.name} | Categoria de barramento flexível`} description={`Explore modelos, estrutura e especificações de ${category.name} em barramentos flexíveis para diversas aplicações.`} alternates={alternates}>
  <Header slot="header" locale="pt" alternates={alternates} />
  <Banner title={`${category.name}`} locale="pt" />
  <ProductCategoryDetail category={category} locale="pt" />
  <Footer slot="footer" locale="pt" />
</BaseLayout>
