---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import CTA from '../../../components/CTA.astro';
import PartnersGrid from '../../../components/PartnersGrid.astro';
import { loadPageJson } from '../../../lib/yanghua/loaders';
import { route } from '../../../lib/yanghua/routes';

const page = await loadPageJson<any>('pt', 'partners');
const content = page?.content ?? {};

const partners = [
  { name: 'BYD', logo: '/images/partners/byd.webp' },
  { name: 'CATL', logo: '/images/partners/catl.webp' },
  { name: 'Huawei', logo: '/images/partners/huawei.webp' },
  { name: 'CRCC', logo: '/images/partners/crcc.png' },
  { name: 'State Grid', logo: '/images/partners/state grid.webp' },
  { name: 'Southern Power Grid', logo: '/images/partners/southern power grid.webp' },
  { name: 'Power China', logo: '/images/partners/power china.png' },
  { name: 'Sinopec', logo: '/images/partners/sinopec.webp' },
  { name: 'Oil China', logo: '/images/partners/oil china.webp' },
  { name: 'Energy China', logo: '/images/partners/energy china .webp' },
  { name: 'CEDC', logo: '/images/partners/cedc.png' },
];

const benefits = [
  {
    title: 'Cooperação estratégica',
    description: 'Uma rede de parceiros focada em barramentos flexíveis de cobre, distribuição de alta corrente e suporte a projetos.',
  },
  {
    title: 'Adoção industrial comprovada',
    description: 'As referências abrangem energia, rede elétrica, transporte, manufatura e infraestrutura atendidas pelas soluções Yanghua.',
  },
  {
    title: 'Suporte confiável ao projeto',
    description: 'As consultas de parceria seguem o mesmo fluxo de orçamento utilizado para produtos, projetos e requisitos técnicos.',
  },
];
---

<BaseLayout title={content?.title ?? 'Parceiros'} description={content?.subtitle ?? 'Conheça os parceiros que confiam nas soluções Yanghua para distribuição de energia.'}>
  <Header slot="header" locale="pt" />
  <Banner title={content?.title ?? 'Parceiros'} locale="pt" />

  <PartnersGrid title={content?.title} subtitle={content?.subtitle} partners={partners} benefits={benefits} />

  <CTA
    title={content?.title ?? 'Nossos parceiros'}
    description={content?.subtitle ?? ''}
    buttonText={content?.ctaAllPartners ?? 'Solicitar orçamento'}
    buttonHref={route('contact', 'pt')}
    locale="pt"
  />

  <Footer slot="footer" locale="pt" />
</BaseLayout>
