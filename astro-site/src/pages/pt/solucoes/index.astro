---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import CTA from '../../../components/CTA.astro';
import { loadMessages } from '../../../lib/yanghua/loaders';
import { t, tRaw } from '../../../lib/yanghua/t';
import { route } from '../../../lib/yanghua/routes';

const messages = await loadMessages('pt');
const solutions = tRaw<any[]>(messages, 'solutions.solutions', []);
---

<BaseLayout title={t(messages, 'solutions.page.title')} description={t(messages, 'solutions.page.description')}>
  <Header slot="header" locale="pt" />
  <Banner title={t(messages, 'solutions.page.title')} locale="pt" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-text-muted leading-relaxed">{t(messages, 'solutions.page.description')}</p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {solutions.map((s) => (
          <a href={`/es/soluciones/${s.id}`} class="group overflow-hidden rounded-lg border border-border bg-surface shadow-sm transition hover:shadow-md">
            <div class="h-44 overflow-hidden bg-background">
              <img src={s.image} alt={s.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="p-6">
              <h3 class="font-heading text-lg font-semibold text-text">{s.title}</h3>
              <p class="mt-2 text-sm text-text-muted">{s.subtitle}</p>
              <p class="mt-3 line-clamp-3 text-sm text-text-muted">{s.description}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                {t(messages, 'solutions.common.viewDetails')}
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title={t(messages, 'solutions.cta.customSolution.title')}
    description={t(messages, 'solutions.cta.customSolution.description')}
    buttonText={t(messages, 'solutions.common.contactUs')}
    buttonHref={route('contact', 'pt')}
  />

  <Footer slot="footer" locale="pt" />
</BaseLayout>

