---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import { loadPageJson } from '../../../lib/yanghua/loaders';

const page = await loadPageJson<any>('pt', 'terms');
---

<BaseLayout title="Termos de Serviço" description="Consulte os termos de uso do site Yanghua Cable, incluindo responsabilidades, conteúdo e condições de acesso.">
  <Header slot="header" locale="pt" />
  <Banner title="Termos de Serviço" locale="pt" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="rounded-lg border border-border bg-surface p-8 text-text-muted">
        A publicação dos termos de serviço depende de aprovação. Adicione conteúdo aprovado em `content/pages/pt/terms.json` para exibi-lo aqui.
      </div>
      {page?.content && Object.keys(page.content).length > 0 && (
        <pre class="mt-8 overflow-auto rounded-lg border border-border bg-background p-6 text-xs text-text">
          {JSON.stringify(page.content, null, 2)}
        </pre>
      )}
    </div>
  </section>

  <Footer slot="footer" locale="pt" />
</BaseLayout>
