---
const { content = {}, locale = 'en' } = Astro.props;
const form = content.form ?? {};
const placeholders = content.placeholders ?? {};
const options = Object.values(content.options ?? {});
---

<section class="bg-surface py-section">
  <div class="mx-auto grid max-w-site grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <span class="text-topper font-bold uppercase tracking-widest text-accent">Inquiry</span>
      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">{content.title}</h2>
      <p class="mt-4 text-text-muted leading-relaxed">{content.subtitle}</p>
      <p class="mt-6 rounded-lg border border-border bg-background p-4 text-sm text-text-muted">{content.privacyNote}</p>
    </div>

    <form data-inquiry-form class="grid gap-5 rounded-lg border border-border bg-background p-6 shadow-sm lg:col-span-7" method="post" action="/api/email/send">
      <input type="hidden" name="type" value="inquiry" />
      <input type="hidden" name="locale" value={locale} />
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium text-text">{form.name}</span>
          <input name="name" required placeholder={placeholders.name} class="rounded-md border border-border bg-surface px-4 py-2.5 text-text" />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium text-text">{form.email}</span>
          <input name="email" type="email" required placeholder={placeholders.email} class="rounded-md border border-border bg-surface px-4 py-2.5 text-text" />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium text-text">{form.company}</span>
          <input name="company" placeholder={placeholders.company} class="rounded-md border border-border bg-surface px-4 py-2.5 text-text" />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium text-text">{form.productInterest}</span>
          <select name="productInterest" class="rounded-md border border-border bg-surface px-4 py-2.5 text-text">
            <option value="">{placeholders.selectCategory}</option>
            {options.map((option: any) => <option value={option}>{option}</option>)}
          </select>
        </label>
      </div>
      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-text">{form.message}</span>
        <textarea name="message" required rows="6" placeholder={placeholders.message} class="min-h-[150px] rounded-md border border-border bg-surface px-4 py-2.5 text-text"></textarea>
      </label>
      <button type="submit" class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent px-6 py-3 font-bold text-accent-fg">
        {content.buttons?.submit}
      </button>
      <p data-inquiry-status class="hidden rounded-md border px-4 py-3 text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]');
  forms.forEach((form) => {
    fetch('/api/csrf', { credentials: 'include' }).catch(() => {});
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>('[data-inquiry-status]');
      if (button) button.disabled = true;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json', 'Accept-Language': form.elements.namedItem('locale')?.value || 'en' },
          body: JSON.stringify({ ...Object.fromEntries(new FormData(form)), type: 'inquiry' }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.success) throw new Error(result.error || 'Failed to submit.');
        form.reset();
        if (status) { status.textContent = 'Inquiry sent successfully.'; status.className = 'rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800'; }
      } catch (error) {
        if (status) { status.textContent = error instanceof Error ? error.message : 'Network error. Please try again later.'; status.className = 'rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800'; }
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>
