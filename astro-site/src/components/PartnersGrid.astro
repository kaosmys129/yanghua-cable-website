---
const { title, subtitle, partners = [], benefits = [] } = Astro.props;
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{title}</h2>
      {subtitle && <p class="mt-3 text-text-muted leading-relaxed">{subtitle}</p>}
    </div>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {partners.map((p: any) => (
        <div class="flex min-h-28 items-center justify-center rounded-lg border border-border bg-background p-5 shadow-sm">
          <img src={p.logo} alt={p.name} class="max-h-16 max-w-full object-contain grayscale transition-all duration-300 hover:grayscale-0" loading="lazy" />
        </div>
      ))}
    </div>

    {benefits.length > 0 && (
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {benefits.map((item: any) => (
          <article class="rounded-lg border border-border bg-background p-6 shadow-sm">
            <h3 class="font-heading text-lg font-semibold text-text">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">{item.description}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
