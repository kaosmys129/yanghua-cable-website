---
interface Props {
  title: string;
  locale?: 'en' | 'es' | 'pt';
  homeLabel?: string;
}

const { title, locale = 'en', homeLabel } = Astro.props;

const homeLabels = {
  en: 'Home',
  es: 'Inicio',
  pt: 'Início'
};

const finalHomeLabel = homeLabel || homeLabels[locale] || 'Home';

const isTransitionPath = (path: string) => {
  return /^\/(en|es|pt)\/(products\/category|productos\/categoria|produtos\/categoria)$/i.test(path);
};

const segments = Astro.url.pathname
  .split('/')
  .filter(Boolean)
  .map((seg, i, arr) => {
    const rawHref = '/' + arr.slice(0, i + 1).join('/');
    return {
      label: seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
      href: isTransitionPath(rawHref) ? '/' + arr.slice(0, i).join('/') : rawHref,
      isLast: i === arr.length - 1,
      isTransition: isTransitionPath(rawHref),
    };
  });
---

<section class="bg-primary py-14 sm:py-16 lg:py-20">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-primary-fg/60">
        <li>
          <a href={`/${locale}`} class="transition-colors hover:text-primary-fg">{finalHomeLabel}</a>
        </li>
        {segments.map(({ label, href, isLast }) => (
          <li class="flex items-center gap-1.5">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            {isLast ? (
              <span aria-current="page" class="text-primary-fg">{label}</span>
            ) : (
              <a href={href} class="transition-colors hover:text-primary-fg">{label}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <h1 class="font-heading text-h1 font-bold uppercase text-primary-fg">
      {title}
    </h1>
  </div>
</section>
