---
const { content = {}, locale = 'en' } = Astro.props;
const milestones = content.timeline?.milestones ?? [];
const team = [
  ['Du', 'Dr Du Jingbiao', 'ceo', 'jpg'],
  ['Hu', 'Mr Hu Runyi', 'cto', 'jpg'],
  ['Li', 'Mr Li Xiaohua', 'engineer', 'jpg'],
  ['peng', 'Mr Peng Qian', 'qa', 'webp'],
];
const certifications = Array.from({ length: 11 }, (_, index) => {
  const number = index + 1;
  return {
    number,
    src: `/images/certifications/cert${number}.webp`,
    alt: `Certification ${number}`,
  };
});
const carouselLabels = locale === 'es'
  ? {
      previous: 'Ver certificados anteriores',
      next: 'Ver más certificados',
      close: 'Cerrar vista ampliada',
    }
  : {
      previous: 'View previous certificates',
      next: 'View more certificates',
      close: 'Close enlarged view',
    };
const videoSrc = locale === 'es' ? '/videos/company-intro-es.mp4' : '/videos/company-intro-en.mp4';
const videoLabels = locale === 'es'
  ? {
      play: 'Reproducir video',
      unsupported: 'Su navegador no soporta la etiqueta de video.',
    }
  : {
      play: 'Play video',
      unsupported: 'Your browser does not support the video tag.',
    };
---

<section class="py-section">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
    <div>
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{content.overview?.title}</h2>
      <p class="mt-4 text-text-muted leading-relaxed">{content.overview?.description}</p>
      <div class="mt-8 grid grid-cols-2 gap-4">
        {Object.values(content.overview?.stats ?? {}).map((value: any) => (
          <div class="rounded-lg border border-border bg-surface p-4 text-center">
            <div class="font-heading text-lg font-bold text-primary">{value}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="overflow-hidden rounded-lg border border-border bg-surface shadow-sm" data-company-video-card>
      <div class="relative bg-dark">
        <video
          class="aspect-video w-full bg-dark object-cover"
          controls
          playsinline
          preload="metadata"
          poster="/images/company-intro.webp"
          data-company-video
        >
          <source src={videoSrc} type="video/mp4" />
          {videoLabels.unsupported}
        </video>
        <button
          type="button"
          class="absolute inset-0 flex items-center justify-center bg-dark/35 text-primary-fg transition hover:bg-dark/45 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          data-company-video-play
          aria-label={videoLabels.play}
        >
          <span class="flex size-16 items-center justify-center rounded-full bg-accent text-accent-fg shadow-xl transition-transform hover:scale-105">
            <svg class="ml-1 size-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </span>
        </button>
      </div>
      <div class="p-5">
        <h3 class="font-heading text-lg font-semibold text-text">{content.video?.companyIntro}</h3>
        <p class="mt-2 text-sm text-text-muted">{content.video?.watchVideo}</p>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const card = document.querySelector('[data-company-video-card]');
    if (!(card instanceof HTMLElement) || card.dataset.initialized === 'true') return;
    const video = card.querySelector('[data-company-video]');
    const playButton = card.querySelector('[data-company-video-play]');
    if (!(video instanceof HTMLVideoElement) || !(playButton instanceof HTMLElement)) return;
    card.dataset.initialized = 'true';

    const hidePlayButton = () => {
      playButton.classList.add('hidden');
    };

    const showPlayButton = () => {
      if (video.currentTime === 0 || video.paused) playButton.classList.remove('hidden');
    };

    playButton.addEventListener('click', async () => {
      try {
        await video.play();
        hidePlayButton();
      } catch {
        video.controls = true;
      }
    });

    video.addEventListener('play', hidePlayButton);
    video.addEventListener('pause', showPlayButton);
    video.addEventListener('ended', showPlayButton);
  })();
</script>

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{content.mission?.title}</h2>
      <p class="mt-3 text-text-muted">{content.mission?.subtitle}</p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <article class="rounded-lg border border-border bg-background p-6 shadow-sm">
        <h3 class="font-heading text-xl font-semibold text-text">{content.mission?.missionTitle}</h3>
        <p class="mt-3 text-text-muted">{content.mission?.missionContent}</p>
        <p class="mt-3 text-text-muted">{content.mission?.missionDescription}</p>
      </article>
      <article class="rounded-lg border border-border bg-background p-6 shadow-sm">
        <h3 class="font-heading text-xl font-semibold text-text">{content.mission?.valuesTitle}</h3>
        <ul class="mt-4 space-y-3">
          {Object.values(content.mission?.values ?? {}).map((value: any) => (
            <li class="flex gap-3 text-text-muted"><span class="mt-2 size-2 shrink-0 rounded-full bg-accent"></span>{value}</li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<section class="py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{content.timeline?.title}</h2>
      <p class="mt-3 text-text-muted">{content.timeline?.subtitle}</p>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-5">
      {milestones.map((item: any) => (
        <article class="rounded-lg border border-border bg-surface p-5 shadow-sm">
          <div class="font-heading text-xl font-bold text-accent">{item.year}</div>
          <p class="mt-2 text-sm text-text-muted">{item.event}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="bg-primary py-section text-primary-fg">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <h2 class="font-heading text-h2 font-bold uppercase">{content.certifications?.title}</h2>
      <p class="mt-3 text-primary-fg/75">{content.certifications?.subtitle}</p>
    </div>

    <div class="relative" data-cert-carousel>
      <button
        type="button"
        class="absolute left-0 top-1/2 z-10 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full border border-primary-fg/20 bg-primary/90 text-primary-fg shadow-lg transition hover:bg-primary-fg hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:flex"
        data-cert-prev
        aria-label={carouselLabels.previous}
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
        </svg>
      </button>

      <div
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-1 pb-3 md:px-14 [&::-webkit-scrollbar]:hidden"
        data-cert-track
        style="scrollbar-width: none;"
      >
        {certifications.map((cert) => (
          <button
            type="button"
            class="group flex h-40 w-36 shrink-0 snap-start items-center justify-center rounded-lg border border-primary-fg/10 bg-primary-fg/10 p-4 transition hover:-translate-y-1 hover:bg-primary-fg/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:w-40 md:h-44 md:w-44"
            data-cert-open
            data-cert-src={cert.src}
            data-cert-alt={cert.alt}
            aria-label={`Open ${cert.alt}`}
          >
            <img
              src={cert.src}
              alt={cert.alt}
              class="max-h-32 w-full object-contain transition duration-300 group-hover:scale-105 md:max-h-36"
              loading="lazy"
            />
          </button>
        ))}
      </div>

      <button
        type="button"
        class="absolute right-0 top-1/2 z-10 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full border border-primary-fg/20 bg-primary/90 text-primary-fg shadow-lg transition hover:bg-primary-fg hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:flex"
        data-cert-next
        aria-label={carouselLabels.next}
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
        </svg>
      </button>
    </div>

    <div
      class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
      data-cert-modal
      aria-hidden="true"
    >
      <button type="button" class="absolute inset-0 cursor-default" data-cert-close aria-label={carouselLabels.close}></button>
      <div class="relative max-h-[88vh] w-full max-w-4xl">
        <button
          type="button"
          class="absolute right-2 top-2 z-10 flex size-11 items-center justify-center rounded-full bg-white text-text shadow-lg transition hover:bg-accent hover:text-accent-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          data-cert-close
          aria-label={carouselLabels.close}
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </button>
        <img
          src=""
          alt=""
          class="mx-auto max-h-[88vh] w-auto rounded-lg bg-white object-contain p-3 shadow-2xl"
          data-cert-modal-img
        />
      </div>
    </div>

    <p class="mx-auto mt-8 max-w-3xl text-center text-primary-fg/75">{content.certifications?.description}</p>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-cert-carousel]');
    const modal = document.querySelector('[data-cert-modal]');
    const modalImg = document.querySelector('[data-cert-modal-img]');
    const track = document.querySelector('[data-cert-track]');
    const prev = document.querySelector('[data-cert-prev]');
    const next = document.querySelector('[data-cert-next]');

    if (!(root instanceof HTMLElement) || root.dataset.initialized === 'true') return;
    if (!(modal instanceof HTMLElement) || !(modalImg instanceof HTMLImageElement) || !(track instanceof HTMLElement)) return;
    root.dataset.initialized = 'true';

    const setModalOpen = (open) => {
      modal.classList.toggle('hidden', !open);
      modal.classList.toggle('flex', open);
      modal.setAttribute('aria-hidden', String(!open));
      document.documentElement.classList.toggle('overflow-hidden', open);
      if (!open) {
        modalImg.removeAttribute('src');
        modalImg.alt = '';
      }
    };

    root.querySelectorAll('[data-cert-open]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLElement)) return;
        const src = button.dataset.certSrc;
        if (!src) return;
        modalImg.src = src;
        modalImg.alt = button.dataset.certAlt || '';
        setModalOpen(true);
      });
    });

    modal.querySelectorAll('[data-cert-close]').forEach((button) => {
      button.addEventListener('click', () => setModalOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) setModalOpen(false);
    });

    const scrollByCard = (direction) => {
      const card = track.querySelector('[data-cert-open]');
      const cardWidth = card instanceof HTMLElement ? card.offsetWidth : 180;
      track.scrollBy({ left: direction * (cardWidth + 16) * 2, behavior: 'smooth' });
    };

    prev?.addEventListener('click', () => scrollByCard(-1));
    next?.addEventListener('click', () => scrollByCard(1));
  })();
</script>

<section class="py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{content.team?.title}</h2>
      <p class="mt-3 text-text-muted">{content.team?.subtitle}</p>
    </div>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {team.map(([image, name, key, ext]) => (
        <article class="rounded-lg border border-border bg-surface p-6 text-center shadow-sm">
          <img src={`/images/about/${image}.${ext}`} alt={name} class="mx-auto size-32 rounded-lg object-cover" loading="lazy" />
          <h3 class="mt-4 font-heading text-lg font-semibold text-text">{name}</h3>
          <p class="mt-1 text-sm font-semibold text-accent">{content.team?.positions?.[key]}</p>
          <p class="mt-2 text-sm text-text-muted">{content.team?.experience?.[key]}</p>
        </article>
      ))}
    </div>
  </div>
</section>
