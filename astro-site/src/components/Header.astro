---
import { route, localeFromPathname } from '../lib/yanghua/routes';
import { buildHreflangAlternates } from '../lib/yanghua/hreflang';
import type { Locale } from '../lib/yanghua/loaders';
import type { NormalizedNavItem, NormalizedSiteSettings } from '../lib/yanghua/site-settings';
import { loadAndNormalizeSiteSettings } from '../lib/yanghua/site-settings';

interface Props {
  locale?: Locale;
  /**
   * 可选：由页面/布局层注入站点数据，避免组件内隐式 IO。
   * 若不传，则组件会自行读取旧站 `content/settings/site.json` 并归一化。
   */
  site?: NormalizedSiteSettings;
  navItems?: NormalizedNavItem[];
  ctaLabel?: string;
  /** Exact translated URLs for pages whose localized slugs are not mechanical. */
  alternates?: { hreflang: string; href: string }[];
}

const currentPath = Astro.url.pathname;
const locale = (Astro.props.locale ?? localeFromPathname(currentPath) ?? 'en') as Locale;
const site = Astro.props.site ?? (await loadAndNormalizeSiteSettings(locale));
const navItems = Astro.props.navItems ?? site.navigation.items;
const ctaLabel = Astro.props.ctaLabel ?? site.navigation.ctaLabel;
const phoneForTel = site.client.phoneForTel || site.client.phoneRaw;
const phoneFormatted = site.client.phoneFormatted || site.client.phoneRaw;
const effectiveAlternates = Astro.props.alternates ?? buildHreflangAlternates(
  currentPath,
  String(Astro.site ?? 'https://www.yhflexiblebusbar.com')
);
const alternatePaths = new Map(effectiveAlternates.map((alternate) => [alternate.hreflang, alternate.href]));
const enPath = alternatePaths.get('en');
const esPath = alternatePaths.get('es');
const ptPath = alternatePaths.get('pt');
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-site items-center justify-between px-4 py-3 sm:px-6">
    <!-- Logo -->
    <a
      href={route('home', locale)}
      class="font-heading text-xl font-bold uppercase tracking-wide text-primary transition-opacity hover:opacity-80"
    >
      {site.brand.name}
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      {navItems.map(({ label, href }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive
                ? 'bg-primary/10 text-primary'
                : 'text-text-muted hover:text-text',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA + phone + lang -->
    <div class="hidden items-center gap-4 lg:flex">
      {locale !== 'en' && enPath && (
        <a href={enPath} hreflang="en" class="rounded-md border border-border px-2.5 py-1.5 text-xs font-semibold uppercase tracking-wide text-text-muted transition-colors hover:border-primary hover:text-primary" title="View in English">EN</a>
      )}
      {locale !== 'es' && esPath && (
        <a href={esPath} hreflang="es" class="rounded-md border border-border px-2.5 py-1.5 text-xs font-semibold uppercase tracking-wide text-text-muted transition-colors hover:border-primary hover:text-primary" title="Ver en Español">ES</a>
      )}
      {locale !== 'pt' && ptPath && (
        <a href={ptPath} hreflang="pt" class="rounded-md border border-border px-2.5 py-1.5 text-xs font-semibold uppercase tracking-wide text-text-muted transition-colors hover:border-primary hover:text-primary" title="Ver em Português">PT</a>
      )}
      <a
        href={`tel:${phoneForTel}`}
        class="text-sm font-semibold text-text hover:text-primary transition-colors"
      >
        {phoneFormatted}
      </a>
      <a
        href={route('contact', locale)}
        class="inline-flex min-h-[44px] items-center rounded-md bg-[#fdb827] px-5 py-2.5 text-sm font-bold text-[#212529] shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#fdb827]"
      >
        {ctaLabel}
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-text-muted hover:bg-surface lg:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <svg id="menu-icon-open" class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="hidden size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-background px-4 pb-6 pt-2 lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      {navItems.map(({ label, href }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class:list={[
              'rounded-md px-3 py-3 text-base font-medium transition-colors',
              isActive
                ? 'bg-primary/10 text-primary'
                : 'text-text-muted hover:text-text hover:bg-surface',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <div class="mt-4 flex flex-col gap-3 border-t border-border pt-4">
      {locale !== 'en' && enPath && (
        <a href={enPath} hreflang="en" class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text-muted hover:text-primary">
          <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>
          English
        </a>
      )}
      {locale !== 'es' && esPath && (
        <a href={esPath} hreflang="es" class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text-muted hover:text-primary">
          <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>
          Español
        </a>
      )}
      {locale !== 'pt' && ptPath && (
        <a href={ptPath} hreflang="pt" class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text-muted hover:text-primary">
          <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>
          Português
        </a>
      )}
      <a
        href={`tel:${phoneForTel}`}
        class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text"
      >
        <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {phoneFormatted}
      </a>
      <a
        href={route('contact', locale)}
        class="flex min-h-[44px] items-center justify-center rounded-md bg-[#fdb827] px-5 py-3 text-base font-bold text-[#212529] shadow-sm transition-opacity hover:opacity-90"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</header>

<script>
  (() => {
    const headerEl = document.querySelector('header');
    const btnEl = document.getElementById('menu-toggle');
    const menuEl = document.getElementById('mobile-menu');
    const iconOpenEl = document.getElementById('menu-icon-open');
    const iconCloseEl = document.getElementById('menu-icon-close');

    if (!headerEl || !btnEl || !menuEl || !iconOpenEl || !iconCloseEl) return;

    const header = /** @type {HTMLElement} */ (headerEl);
    const btn = /** @type {HTMLButtonElement} */ (btnEl);
    const menu = /** @type {HTMLElement} */ (menuEl);
    const iconOpen = /** @type {HTMLElement} */ (iconOpenEl);
    const iconClose = /** @type {HTMLElement} */ (iconCloseEl);
    if (header.dataset.menuInit === 'true') return;
    header.dataset.menuInit = 'true';

    const activeClasses = ['bg-primary/10', 'text-primary'];
    const inactiveDesktop = ['text-text-muted', 'hover:text-text'];
    const inactiveMobile = ['text-text-muted', 'hover:text-text', 'hover:bg-surface'];

    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

    const setMenuOpen = (nextOpen: boolean) => {
      // Hard stop: hamburger/drawer behavior is mobile-only.
      if (isDesktop()) nextOpen = false;
      btn.setAttribute('aria-expanded', String(nextOpen));
      menu.classList.toggle('hidden', !nextOpen);
      iconOpen.classList.toggle('hidden', nextOpen);
      iconClose.classList.toggle('hidden', !nextOpen);
    };

    function syncActiveLinks() {
      const path = window.location.pathname;
      const desktopLinks = header.querySelectorAll('nav[aria-label="Primary navigation"] a');
      const mobileLinks = header.querySelectorAll('#mobile-menu nav a');

      desktopLinks.forEach((link) => {
        const href = link.getAttribute('href') || '';
        const isActive = href === path || (href !== '/' && path.startsWith(href));
        link.classList.toggle(activeClasses[0], isActive);
        link.classList.toggle(activeClasses[1], isActive);
        link.classList.toggle(inactiveDesktop[0], !isActive);
        link.classList.toggle(inactiveDesktop[1], !isActive);
        if (isActive) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });

      mobileLinks.forEach((link) => {
        const href = link.getAttribute('href') || '';
        const isActive = href === path || (href !== '/' && path.startsWith(href));
        link.classList.toggle(activeClasses[0], isActive);
        link.classList.toggle(activeClasses[1], isActive);
        link.classList.toggle(inactiveMobile[0], !isActive);
        link.classList.toggle(inactiveMobile[1], !isActive);
        link.classList.toggle(inactiveMobile[2], !isActive);
        if (isActive) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
    }

    btn.addEventListener('click', () => {
      if (isDesktop()) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isOpen);
    });

    menu.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('a[href]')) setMenuOpen(false);
    });

    document.addEventListener('astro:before-preparation', () => setMenuOpen(false));
    document.addEventListener('astro:after-swap', () => {
      setMenuOpen(false);
      syncActiveLinks();
    });

    // Ensure mobile drawer can't stay open if viewport changes to desktop.
    window.addEventListener('resize', () => setMenuOpen(false));

    setMenuOpen(false);
    syncActiveLinks();
  })();
</script>
