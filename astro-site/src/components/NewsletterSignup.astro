---
import type { Locale } from '../lib/yanghua/loaders';

interface Props {
  locale?: Locale;
}

const locale = (Astro.props.locale ?? 'en') as Locale;

const copy = {
  en: {
    eyebrow: 'Stay informed',
    title: 'Practical power insights, delivered.',
    description: 'Get product updates, project notes, and engineering guidance from Yanghua Cable.',
    placeholder: 'Work email address',
    submit: 'Subscribe',
    privacy: 'Occasional updates only. Unsubscribe anytime.',
    success: 'You’re subscribed. We’ll keep the useful updates coming.',
    error: 'We couldn’t complete your subscription. Please try again.',
    sending: 'Subscribing…',
  },
  es: {
    eyebrow: 'Mantente informado',
    title: 'Información eléctrica útil, directamente en tu correo.',
    description: 'Recibe novedades de productos, proyectos y orientación técnica de Yanghua Cable.',
    placeholder: 'Correo profesional',
    submit: 'Suscribirme',
    privacy: 'Solo enviaremos novedades ocasionales. Puedes cancelar cuando quieras.',
    success: 'Suscripción confirmada. Te enviaremos novedades útiles.',
    error: 'No pudimos completar la suscripción. Inténtalo de nuevo.',
    sending: 'Suscribiendo…',
  },
  pt: {
    eyebrow: 'Fique por dentro',
    title: 'Insights práticos de energia, direto no seu e-mail.',
    description: 'Receba novidades de produtos, projetos e orientações técnicas da Yanghua Cable.',
    placeholder: 'E-mail profissional',
    submit: 'Inscrever-me',
    privacy: 'Enviaremos apenas novidades ocasionais. Cancele quando quiser.',
    success: 'Inscrição confirmada. Enviaremos novidades úteis.',
    error: 'Não foi possível concluir sua inscrição. Tente novamente.',
    sending: 'Inscrevendo…',
  },
} as const;

const text = copy[locale] ?? copy.en;
---

<section class="mb-12 overflow-hidden rounded-xl border border-white/10 bg-dark-surface shadow-lg" aria-labelledby="newsletter-title">
  <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-12">
    <div class="max-w-2xl">
      <p class="text-topper font-bold uppercase tracking-[0.18em] text-accent">{text.eyebrow}</p>
      <h2 id="newsletter-title" class="mt-2 max-w-xl font-heading text-2xl font-bold uppercase leading-tight text-white sm:text-3xl">
        {text.title}
      </h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-surface/75 sm:text-base">{text.description}</p>
    </div>

    <form data-newsletter-form class="w-full lg:min-w-[390px] lg:max-w-[460px]" method="post" action="/api/email/send">
      <input type="hidden" name="type" value="subscribe" />
      <input type="hidden" name="locale" value={locale} />
      <label class="sr-only" for={`newsletter-email-${locale}`}>{text.placeholder}</label>
      <div class="flex flex-col gap-3 sm:flex-row">
        <input
          id={`newsletter-email-${locale}`}
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder={text.placeholder}
          aria-describedby={`newsletter-note-${locale}`}
          class="min-h-[46px] min-w-0 flex-1 rounded-md border border-white/15 bg-dark px-4 py-3 text-sm text-white outline-none transition placeholder:text-surface/45 focus:border-accent focus:ring-2 focus:ring-accent/30"
        />
        <button
          type="submit"
          class="inline-flex min-h-[46px] shrink-0 items-center justify-center rounded-md bg-accent px-5 py-3 text-sm font-bold text-accent-fg shadow-sm transition hover:bg-primary hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-70"
        >
          <span data-newsletter-submit-label>{text.submit}</span>
        </button>
      </div>
      <p id={`newsletter-note-${locale}`} class="mt-3 text-xs text-surface/55">{text.privacy}</p>
      <p data-newsletter-status class="mt-3 hidden rounded-md border px-3 py-2 text-sm" role="status" aria-live="polite"></p>
      <span class="hidden" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off" /></span>
    </form>
  </div>
</section>

<script is:inline define:vars={{ locale, success: text.success, error: text.error, sending: text.sending }}>
  (() => {
    const bindForms = () => {
      document.querySelectorAll('[data-newsletter-form]').forEach((form) => {
        if (form.dataset.newsletterBound === 'true') return;
        form.dataset.newsletterBound = 'true';

        fetch('/api/csrf', { method: 'GET', credentials: 'include' }).catch(() => {});

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const button = form.querySelector('button[type="submit"]');
          const label = form.querySelector('[data-newsletter-submit-label]');
          const status = form.querySelector('[data-newsletter-status]');
          const honeypot = form.elements.namedItem('website');

          if (honeypot instanceof HTMLInputElement && honeypot.value) return;
          if (button) button.disabled = true;
          if (label) label.textContent = sending;
          if (status) status.className = 'mt-3 hidden rounded-md border px-3 py-2 text-sm';

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json', 'Accept-Language': locale },
              body: JSON.stringify(Object.fromEntries(new FormData(form))),
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.success) throw new Error(result.error || error);

            form.reset();
            if (status) {
              status.textContent = success;
              status.className = 'mt-3 rounded-md border border-accent/30 bg-accent/10 px-3 py-2 text-sm text-accent';
            }
          } catch (submissionError) {
            if (status) {
              status.textContent = submissionError instanceof Error ? submissionError.message : error;
              status.className = 'mt-3 rounded-md border border-red-300/30 bg-red-950/30 px-3 py-2 text-sm text-red-100';
            }
          } finally {
            if (button) button.disabled = false;
            if (label) label.textContent = textForSubmit(form);
          }
        });
      });
    };

    const textForSubmit = (form) => {
      const label = form.querySelector('[data-newsletter-submit-label]');
      return label?.dataset.defaultLabel || label?.textContent || '';
    };

    document.querySelectorAll('[data-newsletter-submit-label]').forEach((label) => {
      label.dataset.defaultLabel = label.textContent || '';
    });

    bindForms();
    document.addEventListener('astro:page-load', bindForms);
  })();
</script>
