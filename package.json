{
  "name": "yanghua-b2b-monorepo",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run dev -w astro-site",
    "build": "cd astro-site && pnpm install --frozen-lockfile && pnpm run build && cd .. && rm -rf dist && cp -r astro-site/dist ./dist",
    "start": "npm run preview -w astro-site",
    "check": "npm run check -w astro-site",
    "typecheck": "npm run typecheck -w astro-site",
    "lint": "npm run lint -w astro-site",
    "dev:astro": "npm run dev -w astro-site",
    "build:astro": "npm run build -w astro-site",
    "preview:astro": "npm run preview -w astro-site"
  },
  "workspaces": [
    "astro-site"
  ],
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "chokidar": "^4.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.34.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "vite": "7.3.6"
  },
  "overrides": {
    "vite": "7.3.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7"
  }
}
